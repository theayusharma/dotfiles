@import "~/.cache/wallust/colors-rofi.rasi"

/* ---- Configuration ---- */
configuration {
    modi:                       "dmenu";
    font:                       "JetBrains Nerd Font 11";
    show-icons:                 true;
    display-dmenu:              "󰆏 Clipboard";
    hover-select:               false;
    scroll-method:              1;
    me-select-entry:            "";
    me-accept-entry:            "MousePrimary";
}

/* ---- Window ---- */
window {
    width:                      850px;
    x-offset:                   0px;
    y-offset:                   0px;
    spacing:                    0px;
    padding:                    0px;
    margin:                     0px;
    border:                     2px;
    border-color:               @selected;
    border-radius:              12px;
    cursor:                     "default";
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 false;
    background-color:           @background;
}

/* ---- Mainbox ---- */
mainbox {
    enabled:                    true;
    orientation:                vertical;
    spacing:                    12px;
    padding:                    20px;
    background-color:           transparent;
    children:                   [ "inputbar", "listview", "message" ];
}

/* ---- Inputbar ---- */
inputbar {
    enabled:                    true;
    spacing:                    10px;
    padding:                    10px 14px;
    border:                     1px;
    border-color:               @selected;
    border-radius:              10px;
    background-color:           @background-alt;
    text-color:                 @foreground;
    children:                   [ "entry" ];
}

prompt {
    enabled:                    false;
}

entry {
    enabled:                    true;
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     text;
    placeholder:                "Search clipboard history...";
    placeholder-color:          @foreground-alt;
}

/* ---- Listview ---- */
listview {
    enabled:                    true;
    columns:                    1;
    lines:                      8;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               false;
    fixed-columns:              true;
    spacing:                    6px;
    padding:                    4px 0px 0px 0px;
    background-color:           transparent;
    border:                     0px;
}

/* ---- Element ---- */
element {
    enabled:                    true;
    spacing:                    10px;
    padding:                    10px 14px;
    margin:                     0px;
    cursor:                     pointer;
    background-color:           transparent;
    text-color:                 @foreground;
    border-radius:              8px;
    border:                     0px;
}

element normal.normal,
element alternate.normal {
    background-color:           transparent;
    text-color:                 @foreground;
}

element selected.normal,
element selected.alternate {
    background-color:           @selected;
    text-color:                 @background-alt;
}

element-icon {
    size:                       24px;
    cursor:                     inherit;
    background-color:           transparent;
    text-color:                 inherit;
}

element-text {
    vertical-align:             0.5;
    horizontal-align:           0.0;
    cursor:                     inherit;
    background-color:           transparent;
    text-color:                 inherit;
    highlight:                  inherit;
}

/* ---- Message & Textbox ---- */
message {
    background-color:           transparent;
    border:                     0px;
    margin:                     0px;
    padding:                    0px;
}

textbox {
    padding:                    10px;
    margin:                     0px;
    border-radius:              8px;
    background-color:           @background-alt;
    text-color:                 @foreground;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}

error-message {
    padding:                    15px;
    border-radius:              10px;
    background-color:           @background;
    text-color:                 @foreground;
}
